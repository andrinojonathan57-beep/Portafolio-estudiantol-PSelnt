Algoritmo ContraPositivo
	Definir Numero,Contador como Entero
	Contador<-0
	Escribir "Encuentre numero:"
	Leer Numero
	Mientras Numero<>0 Hacer
		Si numero>0 Entonces
		Contador<-Contador+1 	
	FinSi
	Escribir "Ingrese este numero:"
	Leer numero
FinMientras
Escribir "cantidad de numeros positivos: ",Contador
FinAlgoritmo
