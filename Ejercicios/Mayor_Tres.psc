Algoritmo Mayor_Tres
	Definir Numero1,Numero2,Numero3 Como Entero
	Escribir "Ingrese Numero1", Numero1
	Leer Numero1
	Escribir "Ingrese numero2", Numero2
	Leer Numero2
	Escribir "Ingrese numero3",Numero3
	Leer Numero3
	Si Numero1>=Numero2 y Numero1>=Numero3 Entonces
		Escribir "El mayor es",Numero1
	FinSi
	Si Numero2>Numero1 y Numero2>=Numero3 Entonces
		Escribir "El mayor es", Numero2
	FinSi
	Si Numero3>Numero1 y Numero3>Numero2 Entonces
		Escribir "El mayor es", Numero3
	FinSi
	
FinAlgoritmo
