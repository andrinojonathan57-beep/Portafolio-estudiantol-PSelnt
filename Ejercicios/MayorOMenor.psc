Algoritmo MayorOMenor
	Definir Number1,Number2 Como Entero
	Escribir "Ingrese Number1" Number1
	Leer Number1
	Escribir "Ingrese Number2" Number2
	Leer Number2
	Si Number1<Number2 Entonces
		Escribir "El primer numero es mayor ",Number1
	FinSi
		Si Number1>Number2 Entonces
			Escribir "El primero es menor ",Number2
	FinSi
FinAlgoritmo
